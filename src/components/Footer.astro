---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { HTMLAttributes } from "astro/types";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import SiteStats from "@/components/SiteStats.astro";
type Props = HTMLAttributes<"footer"> & {
  noMarginTop?: boolean;
  showPageStats?: boolean;
};
const {
  noMarginTop,
  showPageStats = true,
  class: className,
  ...attrs
} = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<footer
  {...attrs}
  class:list={["site-footer", className, { "footer-no-margin": noMarginTop }]}
  data-pagefind-ignore
>
  <div class="wide-layout footer-inner">
    <div>
      <a class="footer-brand" href={getRelativeLocaleUrl(locale, "")}
        >Brad.log</a
      ><p>把學習留下來，讓理解慢慢累積。</p>
    </div>
    <nav class="footer-links" aria-label="頁尾導覽">
      <a href={getRelativeLocaleUrl(locale, "tags")}>技術標籤</a>
      <a href={getRelativeLocaleUrl(locale, "archives")}>學習時間軸</a>
      <a href={getAssetPath("rss.xml")}>RSS</a>
      <a href={getAssetPath("privacy/")}>隱私與互動</a>
      <a
        href="https://github.com/bradcocox/brad-log"
        target="_blank"
        rel="noopener noreferrer">GitHub ↗</a
      >
    </nav>
    <SiteStats {showPageStats} />
    <p class="footer-credit">
      © {new Date().getFullYear()} Brad <span aria-hidden="true">·</span> Built with
      <a
        href="https://github.com/satnaing/astro-paper"
        target="_blank"
        rel="noopener noreferrer">AstroPaper</a
      >
    </p>
  </div>
</footer>

---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import config from "@/config";
import BrandLogo from "@/components/BrandLogo.astro";
const locale = Astro.currentLocale ?? config.site.lang;
const currentPath = stripLocale(stripBase(Astro.url.pathname), locale);
const nav = [
  { path: "posts", label: "文章" },
  { path: "categories", label: "主題" },
  { path: "about", label: "關於" },
];
const isActive = (path: string) =>
  currentPath.split("/").filter(Boolean)[0] === path;
---

<a id="skip-to-content" href="#main-content" class="skip-link">跳至主要內容</a>
<header class="site-header" data-pagefind-ignore>
  <div class="wide-layout header-inner">
    <div class="site-brand-wrap" data-brand-logo>
      <a
        class="site-brand"
        href={getRelativeLocaleUrl(locale, "")}
        aria-label="Brad.log 首頁"
      >
        <BrandLogo />
      </a>
      <button
        class="brand-logo-play"
        type="button"
        aria-label="播放 Brad.log 紙張收納動畫"
        title="播放 Logo 動畫"
      ></button>
    </div>
    <nav
      id="menu-items"
      class="site-nav"
      aria-label="主要導覽"
      data-open="false"
    >
      {
        nav.map(item => (
          <a
            href={getRelativeLocaleUrl(locale, item.path)}
            aria-current={isActive(item.path) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header-controls">
      {
        config.features.search !== false && (
          <>
            <form
              class="header-search"
              data-astro-reload
              action={getRelativeLocaleUrl(locale, "search")}
              role="search"
              aria-label="全站搜尋"
            >
              <button type="submit" aria-label="搜尋文章">
                <IconSearch aria-hidden="true" />
              </button>
              <input type="search" name="q" aria-label="搜尋文章" placeholder="搜尋文章…" />
            </form>
            <a
              class="icon-button mobile-search"
              href={getRelativeLocaleUrl(locale, "search")}
              aria-label="搜尋筆記"
              title="搜尋筆記"
            >
              <IconSearch aria-hidden="true" />
            </a>
          </>
        )
      }
      {
        config.features.lightAndDarkMode && (
          <button
            id="theme-btn"
            type="button"
            class="icon-button theme-button"
            title="切換明暗主題"
            aria-label="切換明暗主題"
            aria-labelledby="theme-switch-label"
          >
            <span id="theme-switch-label" class="sr-only">切換明暗主題</span>
            <>
              <IconMoon class="theme-moon" />
              <IconSunHigh class="theme-sun" />
            </>
          </button>
        )
      }
      <button
        id="menu-btn"
        type="button"
        class="icon-button menu-button"
        aria-label="開啟導覽選單"
        aria-expanded="false"
        aria-controls="menu-items"
        ><IconMenuDeep id="menu-icon" /><IconX
          id="close-icon"
          class="hidden"
        /></button
      >
    </div>
  </div>
</header>
<script>
  function setupHeader() {
    const button = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menu = document.querySelector<HTMLElement>("#menu-items");
    if (!button || !menu || button.dataset.ready) return;
    button.dataset.ready = "true";
    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "關閉導覽選單" : "開啟導覽選單");
      menu.dataset.open = String(open);
      document.querySelector("#menu-icon")?.classList.toggle("hidden", open);
      document.querySelector("#close-icon")?.classList.toggle("hidden", !open);
    };
    button.addEventListener("click", () =>
      setOpen(button.getAttribute("aria-expanded") !== "true")
    );
    menu
      .querySelectorAll("a")
      .forEach(link => link.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", event => {
      if (
        event.key === "Escape" &&
        button.getAttribute("aria-expanded") === "true"
      ) {
        setOpen(false);
        button.focus();
      }
    });
    document
      .querySelector("#skip-to-content")
      ?.addEventListener("click", () => {
        const main = document.querySelector<HTMLElement>("#main-content");
        main?.setAttribute("tabindex", "-1");
        main?.focus();
      });
  }
  function setupBrandLogo() {
    const container = document.querySelector<HTMLElement>("[data-brand-logo]");
    const logo = container?.querySelector<HTMLElement>(".brand-logo");
    const playButton = container?.querySelector<HTMLButtonElement>(".brand-logo-play");
    const word = logo?.querySelector<SVGGElement>(".brand-word-log");
    if (!container || !logo || !playButton || !word || container.dataset.ready) return;
    container.dataset.ready = "true";

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const play = () => {
      if (reducedMotion.matches || logo.classList.contains("is-playing")) return;
      logo.classList.add("is-playing");
    };
    const finish = (event: AnimationEvent) => {
      if (event.target === word) logo.classList.remove("is-playing");
    };

    container.addEventListener("pointerenter", play);
    playButton.addEventListener("click", play);
    playButton.addEventListener("focus", play);
    logo.addEventListener("animationend", finish);
  }
  setupHeader();
  setupBrandLogo();
  document.addEventListener("astro:page-load", () => {
    setupHeader();
    setupBrandLogo();
  });
</script>

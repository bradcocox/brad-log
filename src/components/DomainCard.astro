---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import type { Domain } from "@/data/domains";
import config from "@/config";
import DomainIcon from "./DomainIcon.astro";

interface Props {
  domain: Domain;
  count: number;
}
const { domain, count } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    class="domain-card"
    href={getRelativeLocaleUrl(locale, `categories/${domain.id}`)}
  >
    <span class="domain-icon"><DomainIcon domain={domain.id} /></span>
    <span class="domain-card-copy">
      <strong>{domain.name}</strong>
      <span>{domain.description}</span>
    </span>
    <span class="domain-count">{count > 0 ? `${count} 篇` : "籌備中"}</span>
    <IconArrowRight class="domain-card-arrow" aria-hidden="true" />
  </a>
</li>

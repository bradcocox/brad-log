---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Domain } from "@/data/domains";
import config from "@/config";
import DomainIcon from "./DomainIcon.astro";
interface Props {
  domain: Domain;
  count: number;
}
const { domain, count } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    class="domain-card"
    href={getRelativeLocaleUrl(locale, `categories/${domain.id}`)}
    aria-label={`${domain.name}，${count} 篇筆記`}
  >
    <div class="domain-card-top">
      <span class="domain-icon"><DomainIcon domain={domain.id} /></span>
      <span class:list={["domain-count", { "is-empty": count === 0 }]}
        >{count} 篇</span
      >
    </div>
    <h3>{domain.name}</h3>
    <span class="domain-english" lang="en">{domain.english}</span>
    <p>{domain.description}</p>
    <span class="domain-card-action"
      >{count > 0 ? "探索筆記" : "查看領域"}<span aria-hidden="true">↗</span
      ></span
    >
  </a>
</li>

---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Card from "@/components/Card.astro";
import { CONTENT_TYPE_LABELS, DOMAINS, type DomainId } from "@/data/domains";
import config from "@/config";

interface Props {
  posts: CollectionEntry<"posts">[];
  category?: DomainId;
}
const { posts, category } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<div data-post-index>
  {
    posts.length > 0 && (
      <form class="post-filters" data-index-filters hidden>
        <label>
          關鍵字
          <input name="q" type="search" placeholder="標題、摘要或標籤" />
        </label>
        {!category && (
          <label>
            專業領域
            <select name="category">
              <option value="">全部領域</option>
              {DOMAINS.map(domain => (
                <option value={domain.id}>{domain.name}</option>
              ))}
            </select>
          </label>
        )}
        <label>
          文章型態
          <select name="type">
            <option value="">全部型態</option>
            {Object.entries(CONTENT_TYPE_LABELS).map(([value, label]) => (
              <option value={value}>{label}</option>
            ))}
          </select>
        </label>
        <label>
          排序方式
          <select name="sort">
            <option value="updated">最近更新</option>
            <option value="newest">最新發佈</option>
            <option value="oldest">最早發佈</option>
          </select>
        </label>
      </form>
    )
  }
  <div class="list-summary">
    <p data-index-count aria-live="polite">
      <strong>{posts.length}</strong> 篇筆記
    </p>
    {
      config.features.search !== false && (
        <a class="text-link" href={getRelativeLocaleUrl(locale, "search")}>
          搜尋內文 <IconArrowRight aria-hidden="true" />
        </a>
      )
    }
  </div>
  <ul class="editorial-post-list" data-index-list>
    {posts.map(post => <Card {...post} editorial />)}
  </ul>
  <section class="empty-state" data-index-empty hidden>
    <h2>找不到符合條件的筆記</h2>
    <p>試試其他關鍵字或文章型態。</p>
    <button type="reset" class="primary-button" data-index-reset
      >清除篩選</button
    >
  </section>
</div>

<script>
  function initPostIndex() {
    const root = document.querySelector<HTMLElement>("[data-post-index]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";

    const form = root.querySelector<HTMLFormElement>("[data-index-filters]");
    const saveBackUrl = () => {
      sessionStorage.setItem("backUrl", location.pathname + location.search);
    };
    if (!form) {
      saveBackUrl();
      return;
    }

    const list = root.querySelector<HTMLUListElement>("[data-index-list]")!;
    const count = root.querySelector<HTMLElement>("[data-index-count]")!;
    const empty = root.querySelector<HTMLElement>("[data-index-empty]")!;
    const fields = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[name]")
    );
    const rows = Array.from(
      list.querySelectorAll<HTMLElement>("[data-post-card]")
    );
    const params = new URLSearchParams(location.search);
    for (const field of fields) {
      const value = params.get(field.name);
      if (value === null) continue;
      if (
        field instanceof HTMLInputElement ||
        Array.from(field.options).some(option => option.value === value)
      ) {
        field.value = value;
      }
    }

    let lastSort: string | undefined;
    function normalize(value: string) {
      return value.normalize("NFKC").toLocaleLowerCase("zh-TW");
    }

    function update() {
      const values = Object.fromEntries(
        fields.map(field => [field.name, field.value.trim()])
      );
      const { category, type, sort, q } = values;
      const words = normalize(q).split(/\s+/).filter(Boolean);

      if (sort !== lastSort) {
        const dateKey = sort === "updated" ? "updated" : "published";
        rows.sort(
          (a, b) =>
            (Number(b.dataset[dateKey]) - Number(a.dataset[dateKey])) *
            (sort === "oldest" ? -1 : 1)
        );
        list.append(...rows);
        lastSort = sort;
      }

      let visible = 0;
      for (const row of rows) {
        const text = normalize(row.dataset.postSearch ?? "");
        const matches =
          (!category || row.dataset.category === category) &&
          (!type || row.dataset.contentType === type) &&
          words.every(word => text.includes(word));
        row.hidden = !matches;
        if (matches) visible++;
      }
      count.textContent = visible + " 篇筆記";
      empty.hidden = visible > 0;

      const url = new URL(location.href);
      for (const [name, value] of Object.entries(values)) {
        if (value && !(name === "sort" && value === "updated"))
          url.searchParams.set(name, value);
        else url.searchParams.delete(name);
      }
      history.replaceState(history.state, "", url);
      saveBackUrl();
    }

    form.hidden = false;
    form.addEventListener("input", update);
    form.addEventListener("submit", event => event.preventDefault());
    root.querySelector("[data-index-reset]")?.addEventListener("click", () => {
      form.reset();
      update();
      form.querySelector<HTMLInputElement>("[name=q]")?.focus();
    });
    update();
  }

  initPostIndex();
  document.addEventListener("astro:page-load", initPostIndex);
</script>

---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostIndex from "@/components/PostIndex.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

export function getStaticPaths() {
  return [{ params: { page: undefined } }];
}

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
---

<Layout
  title={"所有文章 | " + config.site.title}
  description="依專業領域與文章型態，尋找 Brad 的技術教學、實作與排錯、閱讀紀錄和學習筆記。"
>
  <Header />
  <main id="main-content" class="wide-layout collection-main">
    <nav class="breadcrumbs" aria-label="所在位置">
      <a href={getRelativeLocaleUrl(locale, "")}>首頁</a><span
        aria-hidden="true">/</span
      >
      <span aria-current="page">所有文章</span>
    </nav>
    <header class="collection-header">
      <h1>所有文章</h1>
      <p>依領域、文章型態或關鍵字查找技術筆記。</p>
    </header>
    <PostIndex {posts} />
    {
      posts.length === 0 && (
        <section class="empty-state">
          <h2>第一篇筆記正在整理中。</h2>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

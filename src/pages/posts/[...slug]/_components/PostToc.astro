---
import type { MarkdownHeading } from "astro";
import IconListTree from "@/assets/icons/IconListTree.svg";
import { useTranslations } from "@/i18n";
import { buildTocTree, hasToc } from "@/utils/buildTocTree";
import TocList from "./TocList.astro";

type Props = { headings: MarkdownHeading[] };

const { headings } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const label = t.post.tableOfContents;
const items = buildTocTree(headings);
---

{
  hasToc(headings) && (
    <details class="toc-panel" data-pagefind-ignore>
      <summary id="toc-inline-label">
        <IconListTree class="size-5" aria-hidden="true" />
        {label}
      </summary>
      <nav aria-labelledby="toc-inline-label" data-toc-nav>
        <TocList {items} />
      </nav>
    </details>
  )
}

<script>
  let cleanup: (() => void) | undefined;

  function initToc() {
    cleanup?.();
    cleanup = undefined;

    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(
        "[data-toc-nav] a[href^='#']"
      )
    );
    if (!links.length) return;

    const headings = [
      ...new Set(links.map(link => decodeURIComponent(link.hash.slice(1)))),
    ]
      .map(id => document.getElementById(id))
      .filter(heading => heading !== null);

    let activeId: string | null = null;
    let frame = 0;

    // The active section is the last heading that has scrolled above this line.
    const READING_LINE = 96;

    function update() {
      frame = 0;
      const root = document.documentElement;
      const atBottom = root.scrollTop + innerHeight >= root.scrollHeight - 2;

      let current: HTMLElement | null = null;
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top > READING_LINE) break;
        current = heading;
      }
      if (atBottom) current = headings[headings.length - 1] ?? current;

      const id = current?.id ?? null;
      if (id === activeId) return;
      activeId = id;

      for (const link of links) {
        const isActive = decodeURIComponent(link.hash.slice(1)) === id;
        if (isActive) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");

        // Keep the active item in view when the TOC itself scrolls.
        const list = link.closest<HTMLElement>(
          ".toc-popover nav > ol"
        );
        if (isActive && list && list.scrollHeight > list.clientHeight) {
          const top = link.offsetTop - list.clientHeight / 2;
          const reduced = matchMedia(
            "(prefers-reduced-motion: reduce)"
          ).matches;
          list.scrollTo({ top, behavior: reduced ? "auto" : "smooth" });
        }
      }
    }

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    update();

    cleanup = () => {
      removeEventListener("scroll", schedule);
      removeEventListener("resize", schedule);
      cancelAnimationFrame(frame);
    };
  }

  document.addEventListener("astro:page-load", initToc);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>

<style is:global>
  .post-body {
    position: relative;
  }

  /* ---- list look (side, popover) ---- */
  :is(.toc-panel, .toc-popover) ol {
    list-style: none;
    margin: 0;
    padding-inline-start: 1rem;
  }
  :is(.toc-panel, .toc-popover) ol ol {
    color: color-mix(in oklab, var(--color-foreground) 80%, transparent);
  }
  :is(.toc-panel, .toc-popover) li {
    margin-block: 0.375rem;
  }
  :is(.toc-panel, .toc-popover) nav a {
    position: relative;
    display: inline-block;
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }
  :is(.toc-panel, .toc-popover) nav a::before {
    content: "#";
    content: "#" / "";
    position: absolute;
    inset-inline-start: -0.75rem;
    opacity: 0.6;
  }
  [data-toc-nav] a:hover,
  [data-toc-nav] a[aria-current="true"] {
    color: var(--color-accent);
  }
  [data-toc-nav] a[aria-current="true"] {
    text-decoration: underline dashed;
    text-underline-offset: 4px;
  }
  .toc-label {
    flex-shrink: 0;
    padding-block-end: 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
  }
  /* The label and Back to top stay put; only the list between them scrolls. */
  .toc-popover nav {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .toc-popover nav > ol {
    position: relative;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .toc-panel {
    margin-block-start: 1.25rem;
    padding-inline: 1rem;
    border-block: 1px solid var(--border);
    font-size: 0.875rem;
  }
  .toc-panel summary {
    padding-block: 0.75rem;
    color: var(--accent);
    font-weight: 650;
    cursor: pointer;
  }
  .toc-panel summary svg {
    display: inline-block;
    margin-inline: 0.3rem 0.45rem;
    vertical-align: text-bottom;
  }
  .toc-panel nav {
    padding-block: 0 0.75rem;
  }

  .toc-back-to-top {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }
  .toc-back-to-top:hover {
    color: var(--color-accent);
  }
  :is(.toc-panel, .toc-popover) .toc-back-to-top {
    flex-shrink: 0;
    margin-block-start: 0.5rem;
    padding-block: 0.5rem;
    border-radius: 0;
    border-block-start: 1px dashed var(--color-border);
  }

  /* The layout TOC replaces an author-written one (deprecated, see rehypeInlineToc). */
  .post-primary:has(.toc-panel) .toc-inline {
    display: none;
  }

  @media print {
    .toc-panel {
      display: none !important;
    }
  }
</style>

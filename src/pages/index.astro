---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import DomainCard from "@/components/DomainCard.astro";
import { DOMAINS } from "@/data/domains";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";
const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const recent = posts.slice(0, config.posts.perIndex);
const starter = posts.find(post => post.data.featured) ?? posts[0];
const homePath = getRelativeLocaleUrl(locale, "");
const latestDate = posts[0]
  ? (posts[0].data.modDatetime ?? posts[0].data.pubDatetime)
  : undefined;
const lastUpdated = latestDate
  ? new Intl.DateTimeFormat("zh-TW", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      timeZone: config.site.timezone,
    }).format(latestDate)
  : "準備開始";
---

<Layout>
  <Header />
  <main
    id="main-content"
    class="wide-layout home-main"
    data-home-path={homePath}
  >
    <section class="home-intro" aria-labelledby="intro-title">
      <div class="intro-copy">
        <p class="eyebrow">
          <span class="status-dot" aria-hidden="true"
          ></span>一份持續累積的工程筆記
        </p>
        <h1 id="intro-title">
          從學會一點，<br />到理解更多<span class="brand-dot">。</span>
        </h1>
        <p class="intro-description">
          我是 Brad。這裡記錄技術學習、實作與排錯的過程。<br
            class="desktop-break"
          />把每一次嘗試，整理成下次用得上的知識。
        </p>
        <div class="intro-actions">
          <a
            class="primary-button"
            href={starter
              ? getPostUrl(starter.id, starter.filePath, locale)
              : getRelativeLocaleUrl(locale, "posts")}
            >從第一篇開始 <span aria-hidden="true">→</span></a
          >
          <a class="text-link" href="#domains"
            >依專業領域探索 <span aria-hidden="true">↓</span></a
          >
        </div>
      </div>
      <aside class="notebook-summary" aria-label="筆記概況">
        <div class="summary-top">
          <span lang="en">THE LEARNING LOG</span><span
            class="summary-symbol"
            aria-hidden="true">↗</span>
        </div>
        <p class="summary-title">每一篇，都是前進的足跡。</p>
        <dl class="summary-stats">
          <div><dt>公開筆記</dt><dd>{posts.length}<span>篇</span></dd></div><div
          >
            <dt>探索領域</dt><dd>{DOMAINS.length}<span>個</span></dd>
          </div>
        </dl>
        <div class="summary-updated">
          <span>最近更新</span><span>{lastUpdated}</span>
        </div>
      </aside>
    </section>
    <section class="home-section" aria-labelledby="recent-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">RECENT NOTES</p><h2 id="recent-title">
            最近寫下的筆記
          </h2>
        </div><a class="text-link" href={getRelativeLocaleUrl(locale, "posts")}
          >所有文章 <span aria-hidden="true">→</span></a>
      </div>
      {
        recent.length ? (
          <ul class="post-grid">
            {recent.map(post => (
              <Card {...post} variant="h3" prominent={recent.length === 1} />
            ))}
          </ul>
        ) : (
          <div class="empty-state">
            <>
              <h3>第一篇筆記，正在路上。</h3>
              <p>整理完成後，會從這裡開始記錄學習的足跡。</p>
            </>
          </div>
        )
      }
    </section>
    <section id="domains" class="home-section" aria-labelledby="domains-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">EXPLORE BY FIELD</p><h2 id="domains-title">
            沿著領域，找到你的下一站
          </h2><p class="section-description">
            用專業領域整理知識，用技術標籤串起關聯。
          </p>
        </div><a
          class="text-link"
          href={getRelativeLocaleUrl(locale, "categories")}
          >領域總覽 <span aria-hidden="true">→</span></a>
      </div>
      <ul class="domain-grid">
        {
          DOMAINS.map(domain => (
            <DomainCard
              domain={domain}
              count={
                posts.filter(post => post.data.category === domain.id).length
              }
            />
          ))
        }
      </ul>
    </section>
    <aside class="learning-note">
      <span aria-hidden="true" class="learning-symbol">✳</span><div>
        <h2>不必一次懂全部，先把今天學到的留下來。</h2><p>
          筆記會隨著新的理解持續更新。從問題出發，記下做法，也記下背後的理由。
        </p>
      </div><a class="text-link" href={getRelativeLocaleUrl(locale, "about")}
        >關於這裡 <span aria-hidden="true">→</span></a>
    </aside>
  </main>
  <Footer />
</Layout>
<script>
  const saveHome = () => {
    const main = document.querySelector<HTMLElement>("[data-home-path]");
    if (main?.dataset.homePath)
      sessionStorage.setItem("backUrl", main.dataset.homePath);
  };
  saveHome();
  document.addEventListener("astro:page-load", saveHome);
</script>

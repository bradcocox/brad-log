---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { DOMAINS } from "@/data/domains";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const starter = posts.find(post => post.data.featured) ?? posts[0];
const recent = posts
  .filter(post => post.id !== starter?.id)
  .slice(0, config.posts.perIndex);
const startTopics = DOMAINS.filter(domain =>
  posts.some(post => post.data.category === domain.id)
).slice(0, 4);
const homePath = getRelativeLocaleUrl(locale, "");
const featuredDate =
  starter && (starter.data.modDatetime ?? starter.data.pubDatetime);
const dateFormat = new Intl.DateTimeFormat("zh-TW", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: config.site.timezone,
});
---

<Layout>
  <Header />
  <main
    id="main-content"
    class="wide-layout home-main"
    data-home-path={homePath}
  >
    <section class="featured-story" aria-labelledby="intro-title">
      <p class="featured-kicker">這裡記錄技術學習、實作與排錯。</p>
      {
        starter && featuredDate ? (
          <>
            <h1 id="intro-title">
              {starter.data.featuredTitle ?? starter.data.title}
            </h1>
            <p class="featured-description">{starter.data.description}</p>
            <div class="featured-actions">
              <a
                class="primary-button"
                href={getPostUrl(starter.id, starter.filePath, locale)}
              >
                開始閱讀 <IconArrowRight aria-hidden="true" />
              </a>
              <div class="featured-meta">
                <span>{starter.data.tags.slice(0, 2).join(" · ")}</span>
                <time datetime={featuredDate.toISOString()}>
                  {dateFormat.format(featuredDate)}
                </time>
              </div>
            </div>
          </>
        ) : (
          <h1 id="intro-title">從學會一點，到理解更多。</h1>
        )
      }
    </section>
    <section class="editorial-recent" aria-labelledby="recent-title">
      <div class="editorial-section-heading">
        <h2 id="recent-title">最新文章</h2>
        <a class="text-link" href={getRelativeLocaleUrl(locale, "posts")}>
          所有文章 <IconArrowRight aria-hidden="true" />
        </a>
      </div>
      {
        recent.length > 0 ? (
          <ul class="editorial-post-list">
            {recent.map(post => (
              <Card {...post} variant="h3" editorial />
            ))}
          </ul>
        ) : (
          <p class="editorial-list-note">
            {starter ? "更多筆記正在整理中。" : "第一篇筆記正在整理中。"}
          </p>
        )
      }
    </section>
    {
      startTopics.length > 0 && (
        <aside class="editorial-topics" aria-labelledby="start-title">
          <h2 id="start-title">從這裡開始</h2>
          <ul>
            {startTopics.map(domain => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, `categories/${domain.id}`)}
                >
                  <span>
                    <strong>{domain.name}</strong>
                    <span class="editorial-topic-description">
                      {domain.description}
                    </span>
                  </span>
                  <IconArrowRight aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
          <a
            class="text-link"
            href={getRelativeLocaleUrl(locale, "categories")}
          >
            所有領域 <IconArrowRight aria-hidden="true" />
          </a>
        </aside>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  function saveHome() {
    const main = document.querySelector<HTMLElement>("[data-home-path]");
    if (main?.dataset.homePath)
      sessionStorage.setItem("backUrl", main.dataset.homePath);
  }

  saveHome();
  document.addEventListener("astro:page-load", saveHome);
</script>
